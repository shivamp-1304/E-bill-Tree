# ─── Required Configuration ───────────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgres://[user]:[password]@[host]:[port]/[database]
# Examples:
#   Local:   postgres://localhost:5432/ebilltree
#   Remote:  postgres://user:pass@db.example.com:5432/ebilltree?sslmode=require
DATABASE_URL=postgres://localhost:5432/ebilltree

# Server port (defaults to 3000)
PORT=3000

# ─── Optional ────────────────────────────────────────────────────────────────
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
